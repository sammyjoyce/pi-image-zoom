{
  "name": "pi-image-zoom",
  "version": "0.1.0",
  "description": "Coordinate-accurate, recursive image zoom for pi.dev agents",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi.dev",
    "image",
    "vision",
    "zoom",
    "crop",
    "multimodal"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions",
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/image-zoom.ts"
    ]
  },
  "scripts": {
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "sharp": ">=0.34.0 <1"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@types/node": "^22.0.0",
    "typebox": "*",
    "typescript": "^5.9.0"
  }
}
