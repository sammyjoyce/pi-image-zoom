{
  "flow": "zoom-qa",
  "description": "Fine-detail visual Q&A through the real pi CLI (Opus 5.5 via gateway.sammy.sh, --thinking medium). baseline = zoom_image extension loaded; v1 = no extension.",
  "metrics": [
    { "id": "correct", "label": "Correct", "kind": "binary" },
    { "id": "format_ok", "label": "ANSWER line", "kind": "binary" },
    { "id": "refused", "label": "Refused", "kind": "binary", "better": "lower" }
  ],
  "perf_fields": [
    { "id": "cost_usd", "label": "Cost", "unit": "$" },
    { "id": "latency_s", "label": "Latency", "unit": "s" },
    { "id": "zoom_calls", "label": "Zoom calls" },
    { "id": "zoom_on_target", "label": "Zoom on target" },
    { "id": "tool_calls", "label": "Tool calls" },
    { "id": "in_tokens", "label": "In tokens" },
    { "id": "out_tokens", "label": "Out tokens" }
  ],
  "prices": { "claude-opus-5-5": { "in": 4, "out": 20 } },
  "variant_config": {
    "baseline": { "extension": "extensions/image-zoom.ts" },
    "v1": { "extension": null }
  },
  "harness_paths": [
    "evals/zoom-qa/cases.jsonl",
    "evals/zoom-qa/generate-cases.mjs"
  ]
}
